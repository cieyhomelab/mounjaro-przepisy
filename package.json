{
  "name": "mounjaro-przepisy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/main.ts",
    "dev:client": "vite",
    "lint": "eslint . --max-warnings 0 && prettier --check . && npm run typecheck",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/client && tsc --noEmit -p tests/e2e",
    "test:unit": "vitest run --project unit-node --project unit-client",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node24 --packages=external --sourcemap --outfile=dist/server/main.js",
    "db:generate": "drizzle-kit generate",
    "start": "node dist/server/main.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.5",
    "cheerio": "^1.2.0",
    "dexie": "^4.4.6",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jose": "^6.2.12",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
