# Mounjaro Przepisy – zmienne środowiskowe.
# Skopiuj do .env (nie commituj). Sekrety agentów i testów E2E trzymamy poza repozytorium:
#   ${SH_SECRETS_DIR:-$HOME/.sh-secrets}/mounjaro-przepisy.env
# Kolumna „Od etapu” mówi, w którym etapie specyfikacji zmienna zaczyna być używana.

# --- Podstawy (używane przez szkielet) ---------------------------------------

# WYMAGANA. Hasło użytkownika „app” w PostgreSQL (usługa db w compose.yml).
POSTGRES_PASSWORD=

# Opcjonalna. Port na 127.0.0.1 hosta, pod którym compose.yml wystawia aplikację. Domyślnie 3000.
APP_PORT=3000

# Opcjonalna. Poziom logów: fatal | error | warn | info | debug. Domyślnie info.
LOG_LEVEL=info

# Ustawiane przez pliki Compose, nie w .env:
#   APP_ENV       production | development | test | e2e. Atrapy integracji i endpointy
#                 /api/__test/* działają wyłącznie poza „production”.
#   DATABASE_URL  adres PostgreSQL. Wymagana przy uruchamianiu poza Compose.
#   PORT          port nasłuchu aplikacji w kontenerze. Domyślnie 3000.

# --- Logowanie Google (od etapu 1.1) -----------------------------------------

# WYMAGANA (przy AUTH_MODE=google i na produkcji). Publiczny adres aplikacji (https://…), bez końcowego ukośnika.
# Służy do budowy adresu powrotu OAuth i odnośników w powiadomieniach.
APP_BASE_URL=

# WYMAGANA. Jedyny adres Google, który może się zalogować (S1).
ALLOWED_EMAIL=

# WYMAGANE przy AUTH_MODE=google. Dane klienta OAuth 2.0 z Google Cloud Console.
# Adres powrotu do zarejestrowania: ${APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcjonalna. google | mock. „mock” zastępuje Google wbudowaną atrapą logowania;
# dozwolone tylko, gdy APP_ENV != production. Domyślnie google.
AUTH_MODE=google

# Opcjonalna. Domena aplikacji dla usługi caddy (profil Compose „tls”), która wystawia
# aplikację po HTTPS z automatycznym certyfikatem. Zbędna, gdy serwer ma własne reverse proxy.
APP_DOMAIN=

# --- Odczyt stron z przepisami (od etapu 1.2) --------------------------------

# Opcjonalna. Limit czasu pobierania cudzej strony w milisekundach. Domyślnie 12000;
# wartość powyżej 15000 jest odrzucana (limit 15 s ze specyfikacji). Testy E2E ustawiają mniej.
FETCH_TIMEOUT_MS=12000

# Opcjonalna. true pozwala pobierać strony z adresów prywatnych (strony testowe w sieci
# Compose). Dozwolone tylko, gdy APP_ENV != production. Domyślnie false.
FETCH_ALLOW_PRIVATE_NETWORK=false

# --- Kopie zapasowe (od etapu 1.5) -------------------------------------------

# WYMAGANA na produkcji. Klucz publiczny age, którym szyfrowane są kopie zapasowe.
# Klucz prywatny właściciel trzyma poza serwerem.
BACKUP_AGE_RECIPIENT=

# Opcjonalna. Katalog hosta na zaszyfrowane kopie. Domyślnie ./backups.
BACKUP_DIR=./backups

# --- Powiadomienia push (od etapu 4.2) ---------------------------------------

# WYMAGANE na produkcji od etapu 4.2. Para kluczy VAPID (npx web-push generate-vapid-keys)
# i kontakt w formacie mailto:… wymagany przez usługi push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Opcjonalna. webpush | mock. „mock” zapisuje powiadomienia w skrzynce testowej zamiast
# je wysyłać; dozwolone tylko, gdy APP_ENV != production. Domyślnie webpush.
PUSH_MODE=webpush

# --- Testy ---------------------------------------------------------------------

# Opcjonalna. Identyfikator przebiegu scripts/test-e2e.sh i scripts/test-integration.sh;
# projekt Compose nazywa się e2e-${E2E_RUN_ID}. Bez niej skrypt losuje identyfikator.
E2E_RUN_ID=

# Opcjonalna. 1 włącza testy E2E oznaczone @live, które pobierają strony z prawdziwych
# serwisów kulinarnych. Tylko do ręcznego uruchamiania, nigdy w CI. Domyślnie wyłączone.
E2E_LIVE=
