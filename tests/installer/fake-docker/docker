#!/usr/bin/env bash
# Fake `docker` for the installer tests (docs/adr/0003-instalator-na-serwer.md, decision 8).
#
# The harness copies this directory per test and puts it first on PATH. Behaviour comes from
# the file `state` next to this script (KEY=value lines), not from environment variables,
# because the installer clears the environment before calling Compose. Every call is appended
# to `calls.log` as one line: the arguments, then ` | env: ` and the variable names it received.
#
# Supported state keys (extend together with the installer):
#   ACCESS=denied              `docker info` fails like a socket without permission
#   COMPOSE_VERSION=2.29.1     printed by `docker compose version --short`; `none` = no plugin
#   VOLUME=exists             `docker volume inspect` succeeds (the database volume exists)
#   VAPID_PUBLIC=<text>        first line printed by `docker run` (default: 87 characters)
#   VAPID_PRIVATE=<text>       second line printed by `docker run` (default: 43 characters)
#   UP=build-error             `docker compose ... up` fails with a build error
#   UP=port-busy               `docker compose ... up` fails: "port is already allocated"
#   HEALTH=fail                the health check (`compose exec`) never succeeds
#   HEALTH_AFTER=<n>           the health check fails for the first <n> calls, then succeeds
#   EXIT_<word>=<code>         exit code for a call whose arguments contain <word> (e.g. EXIT_build=1)
set -u
dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
state="$dir/state"

get() {
  local key="$1" default="$2" line
  if [ -f "$state" ]; then
    while IFS= read -r line; do
      if [ "${line%%=*}" = "$key" ]; then
        printf '%s' "${line#*=}"
        return
      fi
    done <"$state"
  fi
  printf '%s' "$default"
}

printf '%s | env: %s\n' "$*" "$(env | cut -d= -f1 | sort | tr '\n' ' ')" >>"$dir/calls.log"

for word in "$@"; do
  code="$(get "EXIT_${word}" '')"
  if [ -n "$code" ]; then
    exit "$code"
  fi
done

case "${1:-}" in
  info)
    if [ "$(get ACCESS ok)" = denied ]; then
      echo 'permission denied while trying to connect to the Docker daemon socket' >&2
      exit 1
    fi
    ;;
  volume)
    if [ "${2:-}" = inspect ] && [ "$(get VOLUME none)" != exists ]; then
      echo "Error: No such volume: ${3:-}" >&2
      exit 1
    fi
    ;;
  run)
    get VAPID_PUBLIC "FAKEPUBLICKEY$(printf 'p%.0s' $(seq 1 74))"
    printf '\n'
    get VAPID_PRIVATE "FAKEPRIVATEKEY$(printf 'q%.0s' $(seq 1 29))"
    printf '\n'
    ;;
  compose)
    for word in "$@"; do
      if [ "$word" = up ]; then
        case "$(get UP ok)" in
          build-error)
            echo 'failed to solve: process "npm run build" did not complete successfully: exit code: 1' >&2
            exit 1
            ;;
          port-busy)
            echo 'Error response from daemon: driver failed programming external connectivity: Bind for 127.0.0.1:3000 failed: port is already allocated' >&2
            exit 1
            ;;
        esac
      fi
      if [ "$word" = exec ]; then
        if [ "$(get HEALTH ok)" = fail ]; then exit 1; fi
        after="$(get HEALTH_AFTER 0)"
        count="$(cat "$dir/health-count" 2>/dev/null || echo 0)"
        echo $((count + 1)) >"$dir/health-count"
        if [ "$count" -lt "$after" ]; then exit 1; fi
      fi
    done
    if [ "${2:-}" = version ]; then
      version="$(get COMPOSE_VERSION 2.29.1)"
      if [ "$version" = none ]; then
        echo "docker: 'compose' is not a docker command." >&2
        exit 1
      fi
      echo "$version"
    fi
    ;;
esac
exit 0
